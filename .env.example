# Local demo defaults only. Never put real credentials in this file or in git.
# Copy to .env and adjust if you need different local values:
#   cp .env.example .env

# PostgreSQL (used by docker compose to create the database/user, and by the app to connect)
POSTGRES_DB=leaseguard
POSTGRES_USER=leaseguard
POSTGRES_PASSWORD=leaseguard_local_dev
POSTGRES_PORT=5432

# App connection settings (must match the POSTGRES_* values above for the app service)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=leaseguard
DB_USER=leaseguard
DB_PASSWORD=leaseguard_local_dev

SERVER_PORT=8080

# Deterministic "as of" date the risk engine uses for the synthetic demo dataset (yyyy-MM-dd).
DEMO_AS_OF_DATE=2026-08-17

# Risk-scoring thresholds (see docs/interview-defense.md for rationale).
RISK_HIGH_RENT_THRESHOLD_USD=1000000
RISK_TENANT_CONCENTRATION_THRESHOLD_PERCENT=25

# Production secrets would be supplied via a secret manager (e.g. AWS Secrets Manager,
# HashiCorp Vault) injected as environment variables at deploy time - never committed here.
